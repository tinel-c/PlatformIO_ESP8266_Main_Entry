#pragma once

// Wi-Fi and MQTT settings for the main-gate firmware.
// Copy this file to src/password.h and replace the placeholders.
// src/password.h is listed in .gitignore and must not be committed.
//
// main.cpp uses these three names only:
//   ssid, password  -> WiFi.begin
//   mqtt_server     -> PubSubClient on port 1883 (anonymous)
//
// mqtt_server is the automation host at 192.168.2.4 (Mosquitto 2.0.18).
// Use the same Wi-Fi network as the other ESP boards.

const char* ssid = "NetworkName";          // 2.4 GHz SSID the ESP8266 joins
const char* password = "networkpassword";  // WPA password for that SSID
const char* mqtt_server = "192.168.2.4";   // broker hostname or IPv4 address
